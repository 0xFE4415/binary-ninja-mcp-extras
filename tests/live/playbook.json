    }
   ]
  },
  {
   "id": "uidf-set-stack-parameter-advice",
   "guards": "Setting a stack-passed argument explains that such arguments cannot be informed.",
   "tool": "rex_uidf_set",
   "args": {
    "function": "many_arguments",
    "variable": "arg7",
    "value": "1"
   },
   "expect": [
    {
     "kind": "error_code",
     "code": "no_variable",
     "message_contains": "stack-passed arguments cannot be informed"
    }
   ]
  },
  {
   "id": "uidf-set-non-parameter-gets-no-advice",
   "guards": "A variable that is not a parameter gets no parameter advice.",
   "tool": "rex_uidf_set",
   "args": {
