  {
   "id": "eval-python-explicit-cause",
   "guards": "An explicit exception cause is reported after the main error.",
   "tool": "rex_eval_python",
   "args": {
    "code": "try:\n    raise KeyError('inner')\nexcept KeyError as cause:\n    raise ValueError('outer') from cause"
   },
   "expect": [
    {
     "kind": "subset",
     "value": "ValueError: outer; caused by KeyError: 'inner'",
     "path": "error"
    },
    {
     "kind": "subset",
     "value": null,
     "path": "result"
    }
   ]
  },
  {
   "id": "eval-python-implicit-context",
   "guards": "An exception raised while handling another one reports the handled error as its context.",
   "tool": "rex_eval_python",
   "args": {
    "code": "try:\n    raise KeyError('inner')\nexcept KeyError:\n    raise ValueError('outer')"
   },
   "expect": [
    {
     "kind": "subset",
     "value": "ValueError: outer; while handling KeyError: 'inner'",
     "path": "error"
    },
    {
     "kind": "subset",
     "value": null,
     "path": "result"
    }
   ]
  },
  {
   "id": "eval-python-tool-error-keeps-code",
   "guards": "A ToolError raised in eval code keeps its error code in the reported error.",
   "tool": "rex_eval_python",
   "args": {
    "code": "import binaryninja.mcp as mcp\nraise mcp.ToolError('my_code', 'my message')"
   },
   "expect": [
    {
     "kind": "subset",
     "value": "binaryninja.mcp.ToolError: my_code: my message",
     "path": "error"
    }
   ]
  },
  {
   "id": "uidf-set-register-parameter-advice",
   "guards": "Setting a register parameter explains that it is live from function entry.",
   "tool": "rex_uidf_set",
   "args": {
    "function": "many_arguments",
    "variable": "arg1",
    "value": "1"
   },
   "expect": [
    {
