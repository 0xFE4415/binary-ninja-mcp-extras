{
 "binary_ninja_version": "6.1.11052-dev Personal",
 "fixture": {
  "path": "fixture.elf",
  "sha256": "a58e72525e56d08f060a3835fd63f60e529481bcbb3cd98a41276c5d40b6fbb7"
 },
 "steps": [
  {
   "id": "help-call-paths-wording",
   "guards": "rex_help says rex_call_paths walks callers by default and needs callees to reach a callee.",
   "tool": "rex_help",
   "args": {
    "tool_name": "rex_call_paths"
   },
   "expect": [
    {
     "kind": "contains",
     "text": "direction defaults to callers",
     "path": "description"
    },
    {
     "kind": "contains",
     "text": "needs callees",
     "path": "description"
    },
    {
     "kind": "includes",
     "path": "parameters",
     "item": {
      "name": "direction",
      "default": "callers"
     }
    }
   ]
  },
  {
   "id": "help-lists-rx-scanners",
   "guards": "The scanning help category lists the native rx_data_find and rx_multi_find tools.",
   "tool": "rex_help",
   "args": {
    "category": "scanning"
   },
   "expect": [
    {
     "kind": "includes",
     "path": "tools",
     "item": {
      "name": "rx_data_find"
     }
    },
    {
     "kind": "includes",
     "path": "tools",
     "item": {
      "name": "rx_multi_find"
     }
    },
    {
     "kind": "includes",
     "path": "tools",
     "item": {
      "name": "rex_data_find"
     }
    }
   ]
  },
  {
   "id": "help-index-lists-rx-scanners",
   "guards": "The help index names the native scanners and the scanning category.",
   "tool": "rex_help",
   "args": {},
   "expect": [
    {
     "kind": "contains",
     "text": "rx_data_find"
    },
    {
     "kind": "contains",
     "text": "rx_multi_find"
    },
    {
     "kind": "includes",
     "path": "categories",
     "item": {
      "name": "scanning"
     }
    }
   ]
  },
  {
   "id": "help-type-library-export-codes",
   "guards": "rex_help lists invalid_params as an error code of rex_type_library_export names and kind.",
   "tool": "rex_help",
   "args": {
    "tool_name": "rex_type_library_export"
   },
   "expect": [
    {
     "kind": "includes",
     "path": "parameters",
     "item": {
      "name": "names",
      "error_codes": [
       "invalid_params"
      ]
     }
    },
    {
     "kind": "includes",
     "path": "parameters",
     "item": {
      "name": "kind",
      "error_codes": [
       "invalid_params"
      ]
     }
    }
   ]
  },
  {
   "id": "help-uidf-set-many-item-codes",
   "guards": "rex_help lists every per-item error code of rex_uidf_set_many.",
   "tool": "rex_help",
   "args": {
    "tool_name": "rex_uidf_set_many"
   },
   "expect": [
    {
     "kind": "includes",
     "path": "parameters",
     "item": {
      "name": "items",
      "error_codes": [
       "invalid_params",
       "no_mlil",
       "no_variable",
       "ambiguous_definition",
       "definition_not_found",
       "set_failed"
      ]
     }
    }
   ]
  },
  {
   "id": "help-constant-find-schema",
   "guards": "The rex_constant_find value schema allows up to 2^64-1, not the rounded float 2^64.",
   "tool": "rex_help",
   "args": {
    "tool_name": "rex_constant_find"
   },
   "expect": [
    {
     "kind": "includes",
     "path": "parameters",
     "item": {
      "name": "value",
      "maximum": 18446744073709551615
     }
    },
    {
     "kind": "not_contains",
     "text": "18446744073709552000"
    }
   ]
  },
  {
   "id": "call-paths-one-route-two-call-sites",
   "guards": "A callee reached from two call sites of one caller is one route, not two.",
   "tool": "rex_call_paths",
   "args": {
    "from_addr": "dup_root",
    "to_addr": "dup_leaf",
    "direction": "callees"
   },
   "expect": [
    {
     "kind": "subset",
     "value": true,
     "path": "reachable"
    },
    {
     "kind": "length",
     "path": "paths",
     "value": 1
    },
    {
     "kind": "unique",
     "path": "paths"
    },
    {
     "kind": "subset",
     "value": [
      [
       {
        "name": "dup_root"
       },
       {
        "name": "dup_mid"
       },
       {
        "name": "dup_leaf"
       }
      ]
     ],
     "path": "paths"
    }
   ]
  },
  {
   "id": "call-paths-callees-through-real-main",
   "guards": "Callee paths from the real main body list each route once.",
   "tool": "rex_call_paths",
   "args": {
    "from_addr": "real_main",
    "to_addr": "dup_leaf",
    "direction": "callees"
   },
   "expect": [
    {
     "kind": "length",
     "path": "paths",
     "value": 1
    },
    {
     "kind": "unique",
     "path": "paths"
    },
    {
     "kind": "subset",
     "value": [
      [
       {
        "name": "real_main"
       },
       {
        "name": "dup_root"
       },
       {
        "name": "dup_mid"
       },
       {
        "name": "dup_leaf"
       }
      ]
     ],
     "path": "paths"
    }
   ]
  },
  {
   "id": "call-paths-diamond-keeps-both-routes",
   "guards": "Two genuinely different routes through a diamond are both kept.",
   "tool": "rex_call_paths",
   "args": {
    "from_addr": "diamond_top",
    "to_addr": "diamond_bottom",
    "direction": "callees"
   },
   "expect": [
    {
     "kind": "length",
     "path": "paths",
     "value": 2
    },
    {
     "kind": "unique",
     "path": "paths"
    },
    {
     "kind": "includes",
     "path": "paths",
     "item": [
      {
       "name": "diamond_top"
      },
      {
       "name": "diamond_left"
      },
      {
       "name": "diamond_bottom"
      }
     ]
    },
    {
     "kind": "includes",
     "path": "paths",
     "item": [
      {
       "name": "diamond_top"
      },
      {
       "name": "diamond_right"
      },
      {
       "name": "diamond_bottom"
      }
     ]
    }
   ]
  },
  {
   "id": "call-paths-callers-default-direction",
   "guards": "Caller paths list each route once.",
   "tool": "rex_call_paths",
   "args": {
    "from_addr": "dup_leaf",
    "to_addr": "dup_root"
   },
   "expect": [
    {
     "kind": "length",
     "path": "paths",
     "value": 1
    },
    {
     "kind": "unique",
     "path": "paths"
    },
    {
     "kind": "subset",
     "value": [
      [
       {
        "name": "dup_leaf"
       },
       {
        "name": "dup_mid"
       },
       {
        "name": "dup_root"
       }
      ]
     ],
     "path": "paths"
    }
   ]
  },
  {
   "id": "call-paths-default-direction-is-callers",
   "guards": "Without a direction, rex_call_paths walks callers, so a downward query finds nothing.",
   "tool": "rex_call_paths",
   "args": {
    "from_addr": "dup_root",
    "to_addr": "dup_leaf"
   },
   "expect": [
    {
     "kind": "subset",
     "value": false,
     "path": "reachable"
    },
    {
     "kind": "length",
     "path": "paths",
     "value": 0
    }
   ]
  },
  {
   "id": "export-symbols-dot-filename",
   "guards": "A filename of '.' is rejected as an invalid file name.",
   "tool": "rex_export_symbols",
   "args": {
    "start": 4198400,
    "end": 4198656,
    "filename": "."
   },
   "expect": [
    {
     "kind": "error_code",
     "code": "invalid_params",
     "message_contains": "file name"
    }
   ]
  },
  {
   "id": "export-symbols-trailing-slash-filename",
   "guards": "A filename that ends in a slash is rejected as an invalid file name.",
   "tool": "rex_export_symbols",
   "args": {
    "start": 4198400,
    "end": 4198656,
    "filename": "sub/"
   },
   "expect": [
    {
     "kind": "error_code",
     "code": "invalid_params",
     "message_contains": "file name"
    }
   ]
  },
  {
   "id": "constraints-minus-one-at-each-width",
   "guards": "A comparison with -1 prints the all-ones value of its own width at 1, 2, 4, and 8 bytes.",
   "tool": "rex_function_constraints",
   "args": {
    "function": "compare_minus_one"
   },
   "expect": [
    {
     "kind": "length",
     "path": "constraints",
     "value": 4
    },
    {
     "kind": "includes",
     "path": "constraints",
     "item": {
      "constant": "0xff",
      "subject": {
       "variable": "arg1"
      }
     }
    },
    {
     "kind": "includes",
     "path": "constraints",
     "item": {
      "constant": "0xffff",
      "subject": {
       "variable": "arg2"
      }
     }
    },
    {
     "kind": "includes",
     "path": "constraints",
     "item": {
      "constant": "0xffffffff",
      "subject": {
       "variable": "arg3"
      }
     }
    },
    {
     "kind": "includes",
     "path": "constraints",
     "item": {
      "constant": "0xffffffffffffffff",
      "subject": {
       "variable": "arg4"
      }
     }
    },
    {
     "kind": "not_regex",
     "pattern": "\"constant\": \"-"
    }
   ]
  },
  {
   "id": "constraints-negative-displacements",
   "guards": "Loads at negative displacements are reported with signed offsets and unsigned constants.",
   "tool": "rex_function_constraints",
   "args": {
    "function": "negative_displacements"
   },
   "expect": [
    {
     "kind": "length",
     "path": "constraints",
     "value": 3
    },
    {
     "kind": "includes",
     "path": "constraints",
     "item": {
      "constant": "0x1234",
      "subject": {
       "kind": "load",
       "base": "arg1",
       "offset": "-0x8"
      }
     }
    },
    {
     "kind": "includes",
     "path": "constraints",
     "item": {
      "constant": "0x41",
      "char": "A",
      "subject": {
       "kind": "load",
       "base": "arg2",
       "offset": "-0x8"
      }
     }
    },
    {
     "kind": "includes",
     "path": "constraints",
     "item": {
      "constant": "0xffffffff",
      "subject": {
       "kind": "load",
       "base": "arg1",
       "offset": "-0xc"
      }
     }
    },
    {
     "kind": "not_regex",
     "pattern": "\"constant\": \"-"
    }
   ]
  },
  {
   "id": "constant-find-max-uint64-integer",
