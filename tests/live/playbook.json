  {
   "id": "quick-main-tail-call-stub-note",
   "guards": "A main that only tail-calls another function is reported as a stub with the real body named.",
   "tool": "rex_quick_main",
   "args": {},
   "expect": [
    {
     "kind": "subset",
     "value": "symbol",
     "path": "method"
    },
    {
     "kind": "subset",
     "value": "0x401050",
     "path": "main"
    },
    {
     "kind": "regex",
     "path": "note",
     "pattern": "^main is a tail-call stub; its real body is real_main at 0x[0-9a-f]+$"
    },
    {
     "kind": "subset",
     "value": [
      "return real_main(argc, argv) __tailcall"
     ],
     "path": "lines"
    }
   ]
  },
