   "args": {
    "start": 4194304,
    "end": 4194560,
    "filename": "sub/"
   },
   "expect": [
    {
     "kind": "error_code",
     "code": "invalid_params",
     "message_contains": "file name"
    }
   ]
  },
  {
   "id": "export-symbols-missing-parent-directory",
   "guards": "A filename whose parent directory does not exist is rejected before anything is exported.",
   "tool": "rex_export_symbols",
   "args": {
    "start": 4194304,
    "end": 4194560,
    "filename": "missing_parent_directory/symbols.csv"
   },
   "expect": [
    {
     "kind": "error_code",
     "code": "invalid_params",
     "message_contains": "the parent of filename is not an existing directory"
    }
   ]
  },
  {
   "id": "constraints-minus-one-at-each-width",
   "guards": "A comparison with -1 prints the all-ones value of its own width at 1, 2, 4, and 8 bytes.",
   "tool": "rex_function_constraints",
   "args": {
    "function": "compare_minus_one"
   },
   "expect": [
    {
     "kind": "length",
     "path": "constraints",
     "value": 4
    },
    {
     "kind": "includes",
     "path": "constraints",
     "item": {
      "constant": "0xff",
      "subject": {
       "variable": "arg1"
      }
     }
    },
    {
     "kind": "includes",
     "path": "constraints",
     "item": {
      "constant": "0xffff",
      "subject": {
       "variable": "arg2"
      }
     }
    },
    {
     "kind": "includes",
     "path": "constraints",
     "item": {
      "constant": "0xffffffff",
      "subject": {
       "variable": "arg3"
      }
     }
    },
    {
     "kind": "includes",
     "path": "constraints",
     "item": {
      "constant": "0xffffffffffffffff",
      "subject": {
       "variable": "arg4"
      }
     }
    },
    {
     "kind": "not_regex",
     "pattern": "\"constant\": \"-"
    }
   ]
  },
  {
   "id": "constraints-negative-displacements",
   "guards": "Loads at negative displacements are reported with signed offsets and unsigned constants.",
   "tool": "rex_function_constraints",
   "args": {
    "function": "negative_displacements"
   },
   "expect": [
    {
     "kind": "length",
     "path": "constraints",
     "value": 3
    },
    {
     "kind": "includes",
     "path": "constraints",
     "item": {
      "constant": "0x1234",
      "subject": {
       "kind": "load",
       "base": "arg1",
       "offset": "-0x8"
      }
     }
    },
    {
     "kind": "includes",
     "path": "constraints",
     "item": {
      "constant": "0x41",
      "char": "A",
      "subject": {
       "kind": "load",
       "base": "arg2",
       "offset": "-0x8"
      }
     }
    },
    {
     "kind": "includes",
     "path": "constraints",
     "item": {
      "constant": "0xffffffff",
      "subject": {
       "kind": "load",
       "base": "arg1",
       "offset": "-0xc"
      }
     }
    },
    {
     "kind": "not_regex",
     "pattern": "\"constant\": \"-"
    }
   ]
  },
  {
