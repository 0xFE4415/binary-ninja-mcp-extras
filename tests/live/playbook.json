{
 "fixture": {
  "path": "fixture.o",
  "base": "0x400000",
  "sha256": "62ccda62694c844a3a48a7da2ff06bc37d8e63bb1eecc2f33028473b626aae8b"
 },
 "steps": [
  {
   "id": "help-call-paths-wording",
   "guards": "rex_help shows how to ask \"does A reach B\" and that direction defaults to callers.",
   "tool": "rex_help",
   "global": true,
   "args": {
    "tool_name": "rex_call_paths"
   },
   "expect": [
    {
     "kind": "contains",
     "text": "\"Does A reach B?\" is from_addr=A, to_addr=B",
     "path": "description"
    },
    {
     "kind": "contains",
     "text": "direction=\"callees\"",
     "path": "description"
    },
    {
     "kind": "includes",
     "path": "parameters",
     "item": {
      "name": "direction",
      "default": "callers"
     }
    }
   ]
  },
  {
   "id": "help-lists-rx-scanners",
   "guards": "The scanning help category lists the native rx_data_find and rx_multi_find tools.",
   "tool": "rex_help",
   "global": true,
   "args": {
    "category": "scanning"
   },
   "expect": [
    {
     "kind": "includes",
     "path": "tools",
     "item": {
      "name": "rx_data_find"
     }
    },
    {
     "kind": "includes",
     "path": "tools",
     "item": {
      "name": "rx_multi_find"
     }
    },
    {
     "kind": "includes",
     "path": "tools",
     "item": {
      "name": "rex_data_find"
     }
    }
   ]
  },
  {
   "id": "help-index-lists-rx-scanners",
   "guards": "The help index names the native scanners and the scanning category.",
   "tool": "rex_help",
   "global": true,
   "args": {},
   "expect": [
    {
     "kind": "contains",
     "text": "rx_data_find"
    },
    {
     "kind": "contains",
     "text": "rx_multi_find"
    },
    {
     "kind": "includes",
     "path": "categories",
     "item": {
      "name": "scanning"
     }
    }
   ]
  },
  {
   "id": "help-constant-find-schema",
   "guards": "The rex_constant_find value schema allows up to 2^64-1, not the rounded float 2^64.",
   "tool": "rex_help",
   "global": true,
   "args": {
    "tool_name": "rex_constant_find"
   },
   "expect": [
    {
     "kind": "includes",
     "path": "parameters",
     "item": {
      "name": "value",
      "maximum": 18446744073709551615
     }
    },
    {
     "kind": "not_contains",
     "text": "18446744073709552000"
    }
   ]
  },
  {
   "id": "call-paths-one-route-two-call-sites",
   "guards": "A callee reached from two call sites of one caller is one route, not two.",
   "tool": "rex_call_paths",
   "args": {
    "from_addr": "dup_root",
    "to_addr": "dup_leaf",
    "direction": "callees"
   },
   "expect": [
    {
     "kind": "subset",
     "value": true,
     "path": "reachable"
    },
    {
     "kind": "length",
     "path": "paths",
     "value": 1
    },
    {
     "kind": "unique",
     "path": "paths"
    },
    {
     "kind": "subset",
     "value": [
      [
       {
        "name": "dup_root"
       },
       {
        "name": "dup_mid"
       },
       {
        "name": "dup_leaf"
       }
      ]
     ],
     "path": "paths"
    }
   ]
  },
  {
   "id": "call-paths-callees-through-real-main",
   "guards": "Callee paths from the real main body list each route once.",
   "tool": "rex_call_paths",
   "args": {
    "from_addr": "real_main",
    "to_addr": "dup_leaf",
    "direction": "callees"
   },
   "expect": [
    {
     "kind": "length",
     "path": "paths",
     "value": 1
    },
    {
     "kind": "unique",
     "path": "paths"
    },
    {
     "kind": "subset",
     "value": [
      [
       {
        "name": "real_main"
       },
       {
        "name": "dup_root"
       },
       {
        "name": "dup_mid"
       },
       {
        "name": "dup_leaf"
       }
      ]
     ],
     "path": "paths"
    }
   ]
  },
  {
   "id": "call-paths-diamond-keeps-both-routes",
   "guards": "Two genuinely different routes through a diamond are both kept.",
   "tool": "rex_call_paths",
   "args": {
    "from_addr": "diamond_top",
    "to_addr": "diamond_bottom",
    "direction": "callees"
   },
   "expect": [
    {
     "kind": "length",
     "path": "paths",
     "value": 2
    },
    {
     "kind": "unique",
     "path": "paths"
    },
    {
     "kind": "includes",
     "path": "paths",
     "item": [
      {
       "name": "diamond_top"
      },
      {
       "name": "diamond_left"
      },
      {
       "name": "diamond_bottom"
      }
     ]
    },
    {
     "kind": "includes",
     "path": "paths",
     "item": [
      {
       "name": "diamond_top"
      },
      {
       "name": "diamond_right"
      },
      {
       "name": "diamond_bottom"
      }
     ]
    }
   ]
  },
  {
   "id": "call-paths-callers-default-direction",
   "guards": "Caller paths list each route once.",
   "tool": "rex_call_paths",
   "args": {
    "from_addr": "dup_leaf",
    "to_addr": "dup_root"
   },
   "expect": [
    {
     "kind": "length",
     "path": "paths",
     "value": 1
    },
    {
     "kind": "unique",
     "path": "paths"
    },
    {
     "kind": "subset",
     "value": [
      [
       {
        "name": "dup_leaf"
       },
       {
        "name": "dup_mid"
       },
       {
        "name": "dup_root"
       }
      ]
     ],
     "path": "paths"
    }
   ]
  },
  {
   "id": "call-paths-default-direction-is-callers",
   "guards": "Without a direction, rex_call_paths walks callers, so a downward query finds nothing.",
   "tool": "rex_call_paths",
   "args": {
    "from_addr": "dup_root",
    "to_addr": "dup_leaf"
   },
   "expect": [
    {
     "kind": "subset",
     "value": false,
     "path": "reachable"
    },
    {
     "kind": "length",
     "path": "paths",
     "value": 0
    }
   ]
  },
  {
   "id": "export-symbols-dot-filename",
   "guards": "A filename of '.' is rejected as an invalid file name.",
