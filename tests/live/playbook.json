  {
   "id": "uidf-set-register-parameter-at-function-start",
   "guards": "A register parameter is informed at the function start and the value folds the decompiled output.",
   "tool": "rex_uidf_set",
   "args": {
    "function": "compare_minus_one",
    "variable": "arg1",
    "value": "0xff"
   },
   "expect": [
    {
     "kind": "subset",
     "path": "definition_site",
     "value": "0x400160"
    },
    {
     "kind": "includes",
     "path": "lines",
     "item": "ASSERT(arg1, ConstantValue: 0xff)"
    },
    {
     "kind": "excludes",
     "path": "lines",
     "item": "if (arg1 == 0xff)"
    }
   ]
  },
