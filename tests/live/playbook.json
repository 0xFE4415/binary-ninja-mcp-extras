    },
    {
     "kind": "includes",
     "path": "functions",
     "item": {
      "name": "store_big_constants"
     }
    },
    {
     "kind": "parity",
     "against": {
      "tool": "rex_constant_find",
      "args": {
       "value": 18446744073709551615
      }
     },
     "fields": [
      "total",
      "functions"
     ]
    }
   ]
  },
  {
   "id": "constant-find-uppercase-hex-string",
   "guards": "A hex string with an uppercase 0X prefix is accepted.",
