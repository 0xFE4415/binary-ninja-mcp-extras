{
 "steps": [
  {
   "id": "data-find-parity-e8-wildcards",
   "guards": "Both scanners return the same first page for the bytes e8 followed by four wildcards, which includes the displacement of a jmp and the start of the cmp after it, not only calls.",
   "tool": "rex_data_find",
   "args": {
    "pattern": "e8 ?? ?? ?? ??",
    "section": ".text",
    "limit": 5
   },
   "expect": [
    {
     "kind": "subset",
     "value": true,
     "path": "truncated"
    },
    {
     "kind": "length",
     "path": "matches",
     "value": 5
    },
    {
     "kind": "parity",
     "against": {
      "tool": "rx_data_find",
      "args": {
       "pattern": "e8 ?? ?? ?? ??",
       "section": ".text",
       "limit": 5
      }
     },
     "fields": [
      "total",
      "truncated",
      "matches"
     ]
    }
   ]
  },
  {
   "id": "data-find-parity-second-page",
   "guards": "Both scanners return the same second page for the bytes e8 followed by four wildcards.",
   "tool": "rex_data_find",
   "args": {
    "pattern": "e8 ?? ?? ?? ??",
    "section": ".text",
    "limit": 5,
    "offset": 5
   },
   "expect": [
    {
     "kind": "subset",
     "path": "",
     "value": {
      "total": 11,
      "truncated": true,
      "matches": [
       "0x4000e8",
       "0x400104",
       "0x400124",
       "0x400287",
       "0x4002b7"
      ]
     }
    },
    {
     "kind": "parity",
     "against": {
      "tool": "rx_data_find",
      "args": {
       "pattern": "e8 ?? ?? ?? ??",
       "section": ".text",
       "limit": 5,
       "offset": 5
      }
     },
     "fields": [
      "total",
      "truncated",
      "matches"
     ]
    }
   ]
  },
  {
   "id": "data-find-parity-whole-view",
   "guards": "Both scanners return the same matches for a whole-view scan.",
   "tool": "rex_data_find",
   "args": {
    "pattern": "c3",
    "limit": 20
   },
   "expect": [
    {
     "kind": "subset",
     "path": "",
     "value": {
      "total": 21,
      "truncated": true
     }
    },
    {
     "kind": "length",
     "path": "matches",
     "value": 20
    },
    {
     "kind": "parity",
     "against": {
      "tool": "rx_data_find",
      "args": {
       "pattern": "c3",
       "limit": 20
      }
     },
     "fields": [
      "total",
      "truncated",
      "matches"
     ]
    }
   ]
  },
  {
   "id": "data-find-parity-no-match",
   "guards": "Both scanners agree on a pattern with no match.",
   "tool": "rex_data_find",
   "args": {
    "pattern": "de ad be ef 5a 5a 5a 5a"
   },
   "expect": [
    {
     "kind": "subset",
     "value": {
      "total": 0,
      "truncated": false,
      "matches": []
     }
    },
    {
     "kind": "parity",
     "against": {
      "tool": "rx_data_find",
      "args": {
       "pattern": "de ad be ef 5a 5a 5a 5a"
      }
     },
     "fields": [
      "total",
      "truncated",
      "matches"
     ]
    }
   ]
  },
  {
   "id": "data-find-parity-invalid-token",
   "guards": "Both scanners reject an invalid token with the same error.",
   "tool": "rex_data_find",
   "args": {
    "pattern": "zz"
   },
   "expect": [
    {
     "kind": "error_code",
     "code": "invalid_pattern"
    },
    {
     "kind": "parity",
     "against": {
      "tool": "rx_data_find",
      "args": {
       "pattern": "zz"
      }
     },
     "fields": [
      "errorCode",
      "errorMessage"
     ],
     "expect_error": true
    }
   ]
  },
  {
   "id": "multi-find-parity-with-data-find",
   "guards": "rx_multi_find returns the pinned matches and agrees with rex_data_find for each pattern.",
   "tool": "rx_multi_find",
   "args": {
    "patterns": [
     "e8 ?? ?? ?? ??",
     "b8 34 12 5a 5a",
     "83 3d ?? ?? ?? ?? 01",
     "31 c0"
    ],
    "limit": 4
   },
   "expect": [
    {
     "kind": "length",
     "path": "results",
     "value": 4
    },
    {
     "kind": "subset",
     "path": "results.0",
     "value": {
      "pattern": "e8 ?? ?? ?? ??",
      "total": 5,
      "truncated": true,
      "matches": [
       "0x40002e",
       "0x400068",
       "0x400084",
       "0x4000a6"
      ]
     }
    },
    {
     "kind": "subset",
     "path": "results.1",
     "value": {
      "pattern": "b8 34 12 5a 5a",
      "total": 1,
      "truncated": false,
      "matches": [
       "0x40003e"
      ]
     }
    },
    {
     "kind": "subset",
     "path": "results.2",
     "value": {
      "pattern": "83 3d ?? ?? ?? ?? 01",
      "total": 2,
      "truncated": false,
      "matches": [
       "0x40000b",
       "0x400044"
      ]
     }
    },
    {
     "kind": "subset",
     "path": "results.3",
     "value": {
      "pattern": "31 c0",
      "total": 4,
      "truncated": false,
      "matches": [
       "0x400000",
       "0x400006",
       "0x400171",
       "0x4001cf"
      ]
     }
    },
    {
     "kind": "parity",
     "against": {
      "tool": "rex_data_find",
      "args": {
       "pattern": "e8 ?? ?? ?? ??",
       "limit": 4
      }
     },
     "fields": [
      "total",
      "truncated",
      "matches"
     ],
     "path": "results.0"
    },
    {
     "kind": "parity",
     "against": {
      "tool": "rex_data_find",
      "args": {
       "pattern": "b8 34 12 5a 5a",
       "limit": 4
      }
     },
     "fields": [
      "total",
      "truncated",
      "matches"
     ],
     "path": "results.1"
    },
    {
     "kind": "parity",
     "against": {
      "tool": "rex_data_find",
      "args": {
       "pattern": "83 3d ?? ?? ?? ?? 01",
       "limit": 4
      }
     },
     "fields": [
      "total",
      "truncated",
      "matches"
     ],
     "path": "results.2"
    },
    {
     "kind": "parity",
     "against": {
      "tool": "rex_data_find",
      "args": {
       "pattern": "31 c0",
       "limit": 4
      }
     },
     "fields": [
      "total",
      "truncated",
      "matches"
     ],
     "path": "results.3"
    }
   ]
  },
  {
   "id": "multi-find-no-match",
   "guards": "rx_multi_find reports a pattern with no match as empty, untruncated, and agrees with rex_data_find.",
   "tool": "rx_multi_find",
   "args": {
    "patterns": [
     "de ad be ef 5a 5a 5a 5a"
    ]
   },
   "expect": [
    {
     "kind": "subset",
     "value": {
      "total": 0,
      "results": [
       {
        "pattern": "de ad be ef 5a 5a 5a 5a",
        "total": 0,
        "truncated": false,
        "matches": []
       }
      ]
     }
    },
    {
     "kind": "parity",
     "against": {
      "tool": "rex_data_find",
      "args": {
       "pattern": "de ad be ef 5a 5a 5a 5a"
      }
     },
     "fields": [
      "total",
      "truncated",
      "matches"
     ],
     "path": "results.0"
    }
   ]
  },
  {
   "id": "multi-find-section-error-parity",
   "guards": "rx_multi_find and rex_data_find report an unknown section the same way.",
   "tool": "rx_multi_find",
   "args": {
    "patterns": [
     "e8"
    ],
    "section": ".te\u0000xt"
   },
   "expect": [
    {
     "kind": "error_code",
     "code": "section_not_found"
    },
    {
     "kind": "parity",
     "against": {
      "tool": "rex_data_find",
      "args": {
       "pattern": "e8",
       "section": ".te\u0000xt"
      }
     },
     "fields": [
      "errorCode",
      "errorMessage"
     ],
     "expect_error": true
    }
   ]
  },
  {
   "id": "undo-probe-comment",
   "guards": "Setup for the undo steps: one annotate batch that adds a comment.",
   "tool": "rex_annotate_many",
   "args": {
    "items": [
     {
      "addr": "0x400060",
      "comment": "undo probe"
     }
    ]
   },
   "expect": [
    {
     "kind": "subset",
     "path": "applied",
     "value": 1
    }
   ]
  },
  {
   "id": "undo-lists-what-it-undid",
   "guards": "rex_undo names the actions of the entry it undid.",
   "tool": "rex_undo",
   "args": {},
   "expect": [
    {
     "kind": "subset",
     "path": "undone",
     "value": true
    },
    {
     "kind": "includes",
     "path": "actions",
     "item": "Comment in function dup_leaf at 0x400060: \"undo probe\""
    },
    {
     "kind": "subset",
     "path": "actions_truncated",
     "value": false
    }
   ]
  },
  {
   "id": "redo-lists-what-it-redid",
   "guards": "rex_redo names the actions of the entry it redid.",
   "tool": "rex_redo",
   "args": {},
   "expect": [
    {
     "kind": "subset",
     "path": "redone",
     "value": true
    },
    {
     "kind": "includes",
     "path": "actions",
     "item": "Comment in function dup_leaf at 0x400060: \"undo probe\""
    }
   ]
  },
  {
   "id": "undo-probe-comment-restored",
   "guards": "Teardown for the undo steps: removes the probe comment again.",
   "tool": "rex_undo",
   "args": {},
   "expect": [
    {
     "kind": "includes",
     "path": "actions",
     "item": "Comment in function dup_leaf at 0x400060: \"undo probe\""
    }
   ]
  },
  {
   "id": "struct-access-real-main-prototype-saved",
   "guards": "Setup: save real_main's current prototype so teardown can put it back.",
   "tool": "rex_eval_python",
   "args": {
    "code": "function = bv.get_functions_by_name('real_main')[0]\nbv.store_metadata('rex_playbook_real_main_type', str(function.type))\nresult = 'probe_s' in str(function.type)"
   },
   "expect": [
    {
     "kind": "subset",
     "value": null,
     "path": "error"
    },
    {
     "kind": "subset",
     "value": "False",
     "path": "result"
    }
   ]
  },
  {
   "id": "struct-access-probe-type-created",
   "guards": "Setup for the struct-from-access steps: an empty user struct probe_s.",
   "tool": "bn_type_struct_create",
   "args": {
    "source": "struct probe_s {};"
   },
   "expect": [
    {
     "kind": "contains",
     "text": "probe_s"
    }
   ]
  },
  {
   "id": "struct-access-probe-applied-to-real-main",
   "guards": "Setup: real_main's second argument, read at +8, is typed struct probe_s*.",
   "tool": "bn_function_prototype_set",
   "args": {
    "function": "real_main",
    "prototype": "uint64_t(int32_t arg1, struct probe_s* arg2)"
   },
   "expect": [
    {
     "kind": "contains",
     "text": "probe_s"
    }
   ]
  },
  {
   "id": "struct-access-probe-analysis-settles",
   "guards": "Setup: analysis records the +8 access through the retyped argument.",
   "tool": "rex_analysis_wait",
   "args": {
    "timeout_ms": 30000
   },
   "expect": [
    {
     "kind": "subset",
     "path": "completed",
     "value": true
    }
   ]
  },
  {
   "id": "struct-access-fills-the-existing-type",
   "guards": "rex_struct_from_access fills probe_s itself and registers no duplicate.",
   "tool": "rex_struct_from_access",
   "args": {
    "name": "probe_s"
   },
   "expect": [
    {
     "kind": "subset",
     "path": "registered",
     "value": "probe_s"
    },
    {
     "kind": "subset",
     "path": "width",
     "value": 16
    },
    {
     "kind": "includes",
     "path": "members",
     "item": {
      "name": "field_8",
      "offset": 8
     }
    }
   ]
  },
  {
   "id": "struct-access-unchanged-layout-rejected",
   "guards": "A second call infers nothing new, so it writes nothing and says so.",
   "tool": "rex_struct_from_access",
   "args": {
    "name": "probe_s"
   },
   "expect": [
    {
     "kind": "error_code",
     "code": "create_failed",
     "message_contains": "beyond its existing members"
    }
   ]
  },
  {
   "id": "struct-access-unknown-type-rejected",
   "guards": "A name that is not a type is rejected up front with the next step.",
   "tool": "rex_struct_from_access",
   "args": {
    "name": "nope"
   },
   "expect": [
    {
     "kind": "error_code",
     "code": "type_not_found",
     "message_contains": "bn_type_struct_create"
    }
   ]
  },
  {
   "id": "struct-access-no-duplicate-type",
   "guards": "No deconflicted duplicate such as probe_s_1 was defined.",
   "tool": "bn_type_list",
   "args": {
    "query": "probe_s"
   },
   "expect": [
    {
     "kind": "contains",
     "text": "probe_s"
    },
    {
     "kind": "not_contains",
     "text": "probe_s_1"
    }
   ]
  },
  {
   "id": "struct-access-undo-restores-the-empty-type",
   "guards": "rex_undo reverses the struct redefinition as one entry.",
   "tool": "rex_undo",
   "args": {},
   "expect": [
    {
     "kind": "subset",
     "path": "undone",
     "value": true
    }
   ]
  },
  {
   "id": "struct-access-undone-type-has-no-members",
   "guards": "After the undo, bn_type_info shows probe_s without the inferred members.",
   "tool": "bn_type_info",
   "args": {
    "type": "probe_s"
   },
   "expect": [
    {
     "kind": "contains",
     "text": "probe_s"
    },
    {
     "kind": "not_contains",
     "text": "field_8"
    }
   ]
  },
  {
   "id": "struct-access-undone-type-is-empty",
   "guards": "After the undo, probe_s is the empty struct again: width 0, no members.",
   "tool": "rex_eval_python",
   "args": {
    "code": "probe = bv.get_type_by_name('probe_s')\nresult = [probe.width, len(probe.members)]"
   },
   "expect": [
    {
     "kind": "subset",
     "value": null,
     "path": "error"
    },
    {
     "kind": "subset",
     "value": "[0, 0]",
     "path": "result"
    }
   ]
  },
  {
   "id": "struct-access-teardown-real-main-prototype",
   "guards": "Teardown: real_main gets back its saved prototype text. It stays a user prototype: the API has no call that clears a function's user type.",
   "tool": "rex_eval_python",
   "args": {
    "code": "function = bv.get_functions_by_name('real_main')[0]\nsaved = bv.query_metadata('rex_playbook_real_main_type')\nfunction.set_user_type(saved)\nbv.remove_metadata('rex_playbook_real_main_type')\nresult = str(function.type) == saved"
   },
   "expect": [
    {
     "kind": "subset",
     "value": null,
     "path": "error"
    },
    {
     "kind": "subset",
     "value": "True",
     "path": "result"
    }
   ]
  },
  {
   "id": "struct-access-teardown-probe-type",
   "guards": "Teardown: the probe_s user type is deleted.",
   "tool": "bn_type_delete",
   "args": {
    "type": "probe_s"
   },
   "expect": [
    {
     "kind": "not_contains",
     "text": "errorCode"
    }
   ]
  },
  {
   "id": "struct-access-teardown-complete",
   "guards": "Teardown check: no probe_s type remains and real_main no longer uses it.",
   "tool": "rex_eval_python",
   "args": {
    "code": "function = bv.get_functions_by_name('real_main')[0]\nresult = [bv.get_type_by_name('probe_s') is None, 'probe_s' in str(function.type)]"
   },
   "expect": [
    {
     "kind": "subset",
     "value": null,
     "path": "error"
    },
    {
     "kind": "subset",
     "value": "[True, False]",
     "path": "result"
    }
   ]
  }
 ]
}
