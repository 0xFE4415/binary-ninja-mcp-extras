from typing import Any


class TypeLibrary:
    @property
    def name(self) -> str | None: ...
    @property
    def arch(self) -> Any: ...
    @staticmethod
    def new(arch: Any, name: str) -> TypeLibrary: ...
    @staticmethod
    def load_from_file(path: str) -> TypeLibrary | None: ...
    def finalize(self) -> bool: ...
    def write_to_file(self, path: str) -> None: ...
